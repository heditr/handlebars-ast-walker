{
  "name": "handlebars-ast-walker",
  "version": "0.1.0",
  "description": "CSP-safe Handlebars 4.7 interpreter that evaluates a pre-parsed AST without code generation.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@handlebars/parser": "^2.2.0"
  },
  "peerDependenciesMeta": {
    "@handlebars/parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@handlebars/parser": "^2.2.4",
    "@types/node": "^24.10.1",
    "handlebars": "4.7.10",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
